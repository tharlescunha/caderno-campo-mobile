{
  "expo": {
    "name": "Caderno de Campo",
    "slug": "caderno-de-campo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "cadernodecampo",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-BR",
        "CFBundleLocalizations": [
          "pt-BR"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B5D3B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F6EE",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0F2A1D",
            "image": "./assets/splash-dark.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Caderno de Campo usa a localização só para buscar o clima na hora de criar um registro."
        }
      ],
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Caderno de Campo usa a câmera para fotografar a área e as visitas de campo.",
          "photosPermission": "O Caderno de Campo acessa suas fotos para anexá-las aos registros."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O Caderno de Campo usa o microfone para gravar áudios dos registros de campo."
        }
      ],
      "expo-asset",
      "expo-sharing"
    ]
  }
}
